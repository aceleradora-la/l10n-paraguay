<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_tax_form_l10n_py" model="ir.ui.view">
        <field name="name">account.tax.form.l10n_py</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_options']" position="before">
                <page string="SIFEN (Paraguay)" name="l10n_py_sifen" invisible="country_code != 'PY'">
                    <group>
                        <field name="l10n_py_iva_affectation" />
                        <field name="l10n_py_iva_rate" />
                        <field
                            name="l10n_py_taxable_proportion"
                            invisible="l10n_py_iva_affectation != '4'"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
